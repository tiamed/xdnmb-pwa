{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/image/(.*)", "destination": "/api/image/$1" },
    { "source": "/thumb/(.*)", "destination": "/api/thumb/$1" },
    { "source": "/post/(.*)", "destination": "/api/post/$1" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
