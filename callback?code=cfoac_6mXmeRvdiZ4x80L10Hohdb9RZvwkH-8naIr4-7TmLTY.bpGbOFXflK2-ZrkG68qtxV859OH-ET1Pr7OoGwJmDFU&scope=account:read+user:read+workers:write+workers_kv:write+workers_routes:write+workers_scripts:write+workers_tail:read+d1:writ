<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cloudflare Workers</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
</head>
<body>

<button id="theme-btn" aria-label="Toggle theme">
  <svg class="icon-sun"    aria-hidden="true"><use href="#sun"/></svg>
  <svg class="icon-moon"   aria-hidden="true"><use href="#moon"/></svg>
  <svg class="icon-system" aria-hidden="true"><use href="#system"/></svg>
</button>

<div class="layout">
  <div class="consent-card">

    <!-- Hero -->
    <div class="consent-hero">
      <div class="consent-icon-ring" aria-label="Cloudflare">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 19" fill="none">
          <path fill="#F6821F" d="m27.16 18.507.204-.735c.242-.873.152-1.68-.255-2.274-.374-.547-.998-.868-1.755-.906l-14.346-.19a.3.3 0 0 1-.127-.034.3.3 0 0 1-.099-.09.31.31 0 0 1-.03-.27.4.4 0 0 1 .128-.185.37.37 0 0 1 .205-.081l14.479-.192c1.717-.082 3.576-1.536 4.227-3.31l.826-2.25a.55.55 0 0 0 .022-.298C29.702 3.29 25.94 0 21.44 0c-4.146 0-7.667 2.792-8.928 6.673a4.1 4.1 0 0 0-2.978-.86c-1.99.206-3.589 1.877-3.786 3.953a4.6 4.6 0 0 0 .11 1.547C2.605 11.41 0 14.189 0 17.603q0 .459.065.911c.009.07.042.134.093.18.05.047.116.072.183.073l26.485.003h.007a.34.34 0 0 0 .205-.076.36.36 0 0 0 .122-.187"/>
          <path fill="#FBAD41" d="M31.94 8.153q-.2 0-.397.01a.2.2 0 0 0-.062.014.2.2 0 0 0-.091.061.24.24 0 0 0-.054.098l-.564 2.033c-.243.874-.152 1.68.254 2.274.375.547.998.868 1.756.906l3.058.191a.3.3 0 0 1 .123.035.28.28 0 0 1 .142.22.3.3 0 0 1-.015.14.4.4 0 0 1-.128.185.37.37 0 0 1-.205.08l-3.177.192c-1.725.083-3.585 1.536-4.235 3.31l-.23.626a.18.18 0 0 0 .017.16.166.166 0 0 0 .134.08h10.941c.064 0 .126-.021.176-.06a.3.3 0 0 0 .106-.16 8.5 8.5 0 0 0 .291-2.216c0-4.517-3.51-8.18-7.84-8.18"/>
        </svg>
        <span class="consent-badge success" aria-label="Connected">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </span>
      </div>
      <div class="consent-hero-text">
        <div class="consent-heading-row">
          <h1>Authorization granted to Wrangler</h1>
        </div>
        <p>You can develop and deploy Workers and Pages directly from your terminal.</p>
      </div>
    </div>

    <hr class="consent-hr">

    <!-- Prompt -->
    <section class="consent-prompt">
      <h2>Build with your favorite AI agent</h2>
      <p>Paste into any AI coding agent to install Cloudflare agent tooling:</p>
      <div class="consent-prompt-actions">
        <button class="copy-prompt-btn" id="copy-prompt-btn" type="button" aria-label="Copy prompt to clipboard">
          <span class="agent-icons" aria-hidden="true">
            <span class="agent-icon"><img class="icon-light" src="/icons/agents/claude/light.svg" alt=""><img class="icon-dark" src="/icons/agents/claude/dark.svg" alt=""></span>
            <span class="agent-icon"><img class="icon-light" src="/icons/agents/codex/light.svg" alt=""><img class="icon-dark" src="/icons/agents/codex/dark.svg" alt=""></span>
            <span class="agent-icon"><img class="icon-light" src="/icons/agents/cursor/light.svg" alt=""><img class="icon-dark" src="/icons/agents/cursor/dark.svg" alt=""></span>
            <span class="agent-icon"><img class="icon-light" src="/icons/agents/copilot/light.svg" alt=""><img class="icon-dark" src="/icons/agents/copilot/dark.svg" alt=""></span>
          </span>
          <span class="cp-label"></span>
        </button>
        <a href="https://developers.cloudflare.com/agent-setup/" class="prompt-secondary">
          Or follow a step-by-step guide for your agent
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    </section>

    <hr class="consent-hr">

    <!-- Footer -->
    <div class="consent-footer-links">
      <a href="https://dash.cloudflare.com/">Dashboard</a>
      <span class="dot" aria-hidden="true">&middot;</span>
      <a href="https://developers.cloudflare.com/workers/">Workers and Pages Docs</a>
      <span class="dot" aria-hidden="true">&middot;</span>
      <a href="https://developers.cloudflare.com/workers/wrangler/">Wrangler CLI</a>
    </div>

  </div>
  <div class="consent-close">
    <p>You can close this window.</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('copy-prompt-btn');
    if (btn) btn.addEventListener('click', function () {
      navigator.clipboard.writeText('Fetch https://developers.cloudflare.com/agent-setup/prompt.md').then(function () {
        btn.dataset.copied = 'true';
        btn.setAttribute('aria-label', 'Copied');
        setTimeout(function () { delete btn.dataset.copied; btn.setAttribute('aria-label', 'Copy prompt to clipboard'); }, 1500);
      }).catch(function () {
        btn.setAttribute('aria-label', 'Copy failed');
        setTimeout(function () { btn.setAttribute('aria-label', 'Copy prompt to clipboard'); }, 1500);
      });
    });
  });
</script>

</body>
</html>
